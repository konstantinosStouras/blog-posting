rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function role() { return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('role', 'student'); }
    function hasRole(value) { return signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid)) && role() == value; }
    function isAdmin() { return verified() && (request.auth.token.email == 'kstouras@gmail.com' || hasRole('admin')); }
    function modulePath(id) { return /databases/$(database)/documents/modules/$(id); }
    function moduleExists(id) { return id is string && exists(modulePath(id)); }
    function staffOf(id) { return isAdmin() || (verified() && hasRole('lecturer') && moduleExists(id) && request.auth.uid in get(modulePath(id)).data.teacherIds); }
    // A blog is the public canvas (and exercise) that one or more modules write on.
    function blogPath(id) { return /databases/$(database)/documents/blogs/$(id); }
    function blogExists(id) { return id is string && exists(blogPath(id)); }
    function blogStaff(id) { return isAdmin() || (verified() && hasRole('lecturer') && blogExists(id) && request.auth.uid in get(blogPath(id)).data.teacherIds); }
    function blogMember(id) { return signedIn() && id is string && exists(/databases/$(database)/documents/blogs/$(id)/members/$(request.auth.uid)); }
    function moduleBlog(id) { return get(modulePath(id)).data.get('blogId', ''); }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function str(field, max) { let v = request.resource.data.get(field, ''); return v is string && v.size() <= max; }
    function universityEmail(value) { return value is string && value.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$'); }
    function memberOf(id) { return signedIn() && exists(/databases/$(database)/documents/modules/$(id)/members/$(request.auth.uid)); }
    function openSubmissions(id) { return moduleExists(id) && get(modulePath(id)).data.get('submissionsOpen', true); }
    function approvalRequired(id) { return get(modulePath(id)).data.get('requireApproval', false); }
    function profileKeys() { return ['firstName','lastName','penName','affiliation','studentId','website','linkedin','bio','contactEmail','photo','registrationKind']; }
    function profileShape() {
      return request.resource.data.keys().hasOnly(profileKeys())
        && str('firstName',120) && str('lastName',120) && str('penName',40) && str('affiliation',200)
        && str('studentId',40) && str('website',300) && str('linkedin',300) && str('bio',800) && str('contactEmail',200) && str('photo',120000)
        && request.resource.data.get('registrationKind','student') in ['student','teacher','instructor'];
    }
    // Students write under a generated alias (adjective-noun-number, see aliases.js):
    // a student profile may be created only with one, and may change its pen name only to one.
    function staffProfile() { return request.resource.data.get('registrationKind','student') in ['teacher','instructor'] || hasRole('lecturer') || isAdmin(); }
    function aliasName() { return request.resource.data.get('penName','').matches('^[a-z]+-[a-z]+-[0-9]{3}$'); }
    match /profiles/{uid} {
      allow read: if own(uid) || isAdmin();
      allow create: if own(uid) && profileShape() && (staffProfile() || aliasName());
      allow update: if own(uid) && profileShape() && (staffProfile() || aliasName() || request.resource.data.get('penName','') == resource.data.get('penName',''));
      allow delete: if isAdmin();
    }
    match /userDirectory/{uid} {
      allow read: if own(uid) || isAdmin();
      allow create, update: if own(uid)
        && request.resource.data.keys().hasOnly(['name','firstName','lastName','studentId','penName','email','first','seen','signedInAt','emailVerified','affiliation','contactEmail'])
        && request.resource.data.email == request.auth.token.email
        && str('name',200) && str('firstName',120) && str('lastName',120) && str('studentId',40) && str('penName',40) && str('affiliation',300) && str('contactEmail',200)
        && request.resource.data.get('signedInAt',0) is number
        && (!('emailVerified' in request.resource.data) || request.resource.data.emailVerified == request.auth.token.email_verified)
        && request.resource.data.first is number && request.resource.data.seen is number;
      allow delete: if isAdmin();
    }
    match /registeredUsers/{uid} {
      allow read: if isAdmin();
      allow create, update: if own(uid) && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t is number;
      allow delete: if isAdmin();
    }
    function invitationMatches(d) { return verified() && (request.auth.token.email == d.ucdEmail || (d.gmail != '' && request.auth.token.email == d.gmail)); }
    function invitationValid(d) { return invitationMatches(d) && !d.revoked && d.expiresAt > request.time.toMillis() && d.acceptedBy == ''; }
    match /teacherInvites/{inviteId} {
      allow get: if isAdmin() || invitationMatches(resource.data);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['ucdEmail','gmail','createdBy','createdAt','expiresAt','acceptedBy','revoked','code'])
        && universityEmail(request.resource.data.ucdEmail) && str('gmail',200)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is number && request.resource.data.expiresAt is number
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + 8 * 86400000
        && request.resource.data.acceptedBy == '' && request.resource.data.revoked == false;
      allow update: if (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked']) && request.resource.data.revoked is bool)
        || (invitationValid(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedBy'])
          && request.resource.data.acceptedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'lecturer'
          && getAfter(/databases/$(database)/documents/roles/$(request.auth.uid)).data.inviteId == inviteId);
      allow delete: if false;
    }
    function invitationRole(uid) {
      let id = request.resource.data.get('inviteId','');
      let path = /databases/$(database)/documents/teacherInvites/$(id);
      return own(uid) && verified() && id is string && exists(path)
        && invitationValid(get(path).data)
        && getAfter(path).data.acceptedBy == uid
        && get(/databases/$(database)/documents/profiles/$(uid)).data.contactEmail == get(path).data.ucdEmail
        && request.resource.data.keys().hasOnly(['role','inviteId','setBy','setAt'])
        && request.resource.data.role == 'lecturer'
        && request.resource.data.setBy == 'invitation' && request.resource.data.setAt is number;
    }
    match /roles/{uid} {
      allow read: if own(uid) || isAdmin();
      allow create, update: if (isAdmin() && request.resource.data.keys().hasOnly(['role','setBy','setAt','inviteId']) && request.resource.data.role in ['student','lecturer','admin'])
        || invitationRole(uid);
      allow delete: if isAdmin();
    }
    // This index contains only code-routing metadata, never names or emails.
    // Individual codes can be resolved; listing every active code is forbidden.
    match /registrationCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if code.matches('^[a-z]{3,30}(-[0-9]{3})?$')
        && request.resource.data.keys().hasOnly(['code','kind','inviteId','moduleId','expiresAt','revoked'])
        && request.resource.data.revoked == false
        && request.resource.data.code == code && request.resource.data.expiresAt is number
        && ((isAdmin() && request.resource.data.kind == 'instructor'
          && getAfter(/databases/$(database)/documents/teacherInvites/$(request.resource.data.inviteId)).data.code == code
          && request.resource.data.moduleId == '')
        || (request.resource.data.kind == 'student' && staffOf(request.resource.data.moduleId)
          && getAfter(/databases/$(database)/documents/moduleInvites/$(request.resource.data.inviteId)).data.code == code
          && getAfter(/databases/$(database)/documents/moduleInvites/$(request.resource.data.inviteId)).data.moduleId == request.resource.data.moduleId));
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked'])
        && request.resource.data.revoked == true
        && ((isAdmin() && resource.data.kind == 'instructor'
          && getAfter(/databases/$(database)/documents/teacherInvites/$(resource.data.inviteId)).data.revoked == true)
        || (resource.data.kind == 'student' && staffOf(resource.data.moduleId)
          && getAfter(/databases/$(database)/documents/moduleInvites/$(resource.data.inviteId)).data.revoked == true));
      allow delete: if false;
    }
    match /moduleInvites/{inviteId} {
      allow get: if staffOf(resource.data.moduleId) || (verified()
        && (resource.data.get('recipientEmail','') == ''
          || get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.contactEmail == resource.data.recipientEmail));
      allow list: if staffOf(resource.data.moduleId);
      allow create: if staffOf(request.resource.data.moduleId)
        && request.resource.data.keys().hasOnly(['moduleId','code','createdBy','createdAt','expiresAt','revoked','recipientEmail'])
        && str('recipientEmail',200)
        && (request.resource.data.get('recipientEmail','') == '' || universityEmail(request.resource.data.recipientEmail))
        && request.resource.data.code.matches('^[a-z]{3,30}(-[0-9]{3})?$')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is number && request.resource.data.expiresAt is number
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + 31 * 86400000
        && request.resource.data.revoked == false;
      allow update: if staffOf(resource.data.moduleId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked'])
        && request.resource.data.revoked is bool;
      allow delete: if false;
    }
    function validModuleInvite(moduleId, inviteId) {
      let path = /databases/$(database)/documents/moduleInvites/$(inviteId);
      return inviteId is string && exists(path) && get(path).data.moduleId == moduleId
        && get(path).data.revoked == false && get(path).data.expiresAt > request.time.toMillis()
        && (get(path).data.get('recipientEmail','') == '' || get(path).data.recipientEmail == request.resource.data.contactEmail);
    }
    function moduleShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title','code','description','teacherName','teacherIds','createdBy','createdAt','updatedAt','submissionsOpen','requireApproval','blogId','academicYear','deadline','brightspaceUrl'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && str('code',40) && str('description',1200) && str('teacherName',200)
        && blogExists(d.blogId) && str('academicYear',20) && str('deadline',20) && str('brightspaceUrl',300)
        && d.teacherIds is list && d.teacherIds.size() > 0 && d.teacherIds.size() <= 20
        && d.createdBy is string && d.createdAt is number && d.updatedAt is number
        && d.submissionsOpen is bool && d.requireApproval is bool;
    }
    match /modules/{moduleId} {
      allow read: if true;
      // A module may only write on a blog its instructor owns (or any blog, for the admin).
      allow create: if moduleShape() && moduleId.matches('^[a-z0-9][a-z0-9-]{1,79}$')
        && request.resource.data.createdBy == request.auth.uid && blogStaff(request.resource.data.blogId)
        && (isAdmin() || (verified() && hasRole('lecturer') && request.resource.data.teacherIds == [request.auth.uid]));
      allow update: if moduleShape() && staffOf(moduleId) && blogStaff(request.resource.data.blogId)
        && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt
        && (isAdmin() || request.resource.data.teacherIds == resource.data.teacherIds);
      allow delete: if false;
      match /members/{uid} {
        allow read: if own(uid) || staffOf(moduleId);
        function memberShape() { return own(uid) && verified() && moduleExists(moduleId)
          && request.resource.data.keys().hasOnly(['uid','firstName','lastName','contactEmail','studentId','registrationKind','penName','email','joinedAt','inviteId','affiliation','lastSeenAt','lastSignInAt'])
          && request.resource.data.uid == uid && request.resource.data.email == request.auth.token.email
          && universityEmail(request.resource.data.contactEmail)
          && str('firstName',120) && str('lastName',120) && str('studentId',40) && str('penName',40)
          && str('affiliation',200) && request.resource.data.affiliation.size() > 0
          && request.resource.data.joinedAt is number
          && request.resource.data.get('lastSeenAt',0) is number && request.resource.data.get('lastSignInAt',0) is number
          && request.resource.data.registrationKind in ['student','teacher','instructor']
          && ((request.resource.data.registrationKind == 'student' && request.resource.data.studentId.size() > 0)
            || (request.resource.data.registrationKind in ['teacher','instructor'] && (hasRole('lecturer') || isAdmin()))); }
        allow create: if memberShape() && validModuleInvite(moduleId,request.resource.data.inviteId);
        allow update: if memberShape() && request.resource.data.inviteId == resource.data.inviteId;
        allow delete: if own(uid) || isAdmin();
      }
    }
    function blogShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title','description','teacherIds','createdBy','createdAt','updatedAt','brief','categoryLabel','categories','organisationLabel','minWords','maxWords','outline','checklist','allowComments','replyRules'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && str('description',1200) && str('brief',60000) && str('categoryLabel',40) && str('organisationLabel',60) && str('outline',20000) && str('replyRules',1000)
        && d.get('categories',[]) is list && d.get('categories',[]).size() <= 30
        && d.get('checklist',[]) is list && d.get('checklist',[]).size() <= 12
        && d.get('minWords',0) is number && d.get('maxWords',0) is number && d.get('allowComments',true) is bool
        && d.teacherIds is list && d.teacherIds.size() > 0 && d.teacherIds.size() <= 20
        && d.createdBy is string && d.createdAt is number && d.updatedAt is number;
    }
    match /blogs/{blogId} {
      allow read: if true;
      allow create: if blogShape() && blogId.matches('^[a-z0-9][a-z0-9-]{1,79}$')
        && request.resource.data.createdBy == request.auth.uid
        && (isAdmin() || (verified() && hasRole('lecturer') && request.resource.data.teacherIds == [request.auth.uid]));
      allow update: if blogShape() && blogStaff(blogId)
        && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt
        && (isAdmin() || request.resource.data.teacherIds == resource.data.teacherIds);
      allow delete: if false;
      // Who may comment across the modules sharing this canvas: written together with
      // the module membership (existsAfter), holding nothing but the link to it.
      match /members/{uid} {
        allow read: if own(uid) || blogStaff(blogId) || staffOf(resource.data.moduleId);
        allow create, update: if own(uid) && verified()
          && request.resource.data.keys().hasOnly(['uid','moduleId','joinedAt'])
          && request.resource.data.uid == uid && request.resource.data.joinedAt is number
          && moduleExists(request.resource.data.moduleId) && moduleBlog(request.resource.data.moduleId) == blogId
          && (existsAfter(/databases/$(database)/documents/modules/$(request.resource.data.moduleId)/members/$(uid)) || staffOf(request.resource.data.moduleId));
        allow delete: if own(uid) || isAdmin();
      }
    }
    function postShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title','slug','body','excerpt','category','organisation','industries','tags','featuredImage','status','featured','authorId','authorName','wordCount','createdAt','updatedAt','publishedAt','reviewNote','moduleId','blogId','academicYear'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.slug is string && d.slug.size() > 0 && d.slug.size() <= 120
        && d.body is string && d.body.size() <= 900000
        && str('excerpt',400) && str('category',80) && str('organisation',160) && str('authorName',60) && str('reviewNote',2000)
        && str('featuredImage',800000) && d.get('tags',[]) is list && d.get('tags',[]).size() <= 12
        && d.get('industries',[]) is list && d.get('industries',[]).size() <= 5
        && d.status in ['draft','pending','published'] && d.get('featured',false) is bool
        && d.authorId is string && moduleExists(d.moduleId)
        && d.blogId == moduleBlog(d.moduleId) && str('academicYear',20);
    }
    match /posts/{id} {
      allow get: if signedIn() && resource == null;   // the writer checks a fresh id before its first save
      // Posts, comments, votes and likes are read by signed-in accounts only; the app shows each
      // person the blog(s) of their modules. Signed out, there is only the front door.
      allow read: if signedIn() && (resource.data.status == 'published' || own(resource.data.authorId) || staffOf(resource.data.moduleId) || blogStaff(resource.data.blogId));
      allow create: if verified() && postShape() && request.resource.data.authorId == request.auth.uid
        && (staffOf(request.resource.data.moduleId) || blogStaff(request.resource.data.blogId)
          || (memberOf(request.resource.data.moduleId) && openSubmissions(request.resource.data.moduleId)
            && request.resource.data.authorName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('penName','') && request.resource.data.authorName.matches('^([a-z]+-[a-z]+-[0-9]{3}|student_[a-z0-9]+)$')
            && request.resource.data.get('featured',false) == false
            && (request.resource.data.status != 'published' || !approvalRequired(request.resource.data.moduleId))));
      allow update: if verified() && postShape()
        && request.resource.data.moduleId == resource.data.moduleId
        && request.resource.data.authorId == resource.data.authorId
        && (staffOf(resource.data.moduleId) || blogStaff(resource.data.blogId)
          || (own(resource.data.authorId) && memberOf(resource.data.moduleId) && openSubmissions(resource.data.moduleId)
            && request.resource.data.authorName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('penName','') && request.resource.data.authorName.matches('^([a-z]+-[a-z]+-[0-9]{3}|student_[a-z0-9]+)$')
            && request.resource.data.createdAt == resource.data.createdAt
            && (request.resource.data.get('publishedAt', null) == resource.data.get('publishedAt', null) || (resource.data.status != 'published' && request.resource.data.status == 'published'))
            && request.resource.data.get('featured',false) == resource.data.get('featured',false)
            && (request.resource.data.status != 'published' || !approvalRequired(resource.data.moduleId))));
      allow delete: if isAdmin() || (verified() && own(resource.data.authorId) && resource.data.status != 'published');
      // Poll votes: one document per poll and account; counts are changeable.
      match /votes/{voteId} {
        allow read: if signedIn();
        allow create, update: if own(request.resource.data.uid) && verified()
          && request.resource.data.keys().hasOnly(['pollId','uid','option','t'])
          && request.resource.data.pollId is string && request.resource.data.pollId.size() <= 64
          && voteId == request.resource.data.pollId + '_' + request.auth.uid
          && request.resource.data.option is int && request.resource.data.option >= 0 && request.resource.data.option < 10
          && request.resource.data.t is number
          && get(/databases/$(database)/documents/posts/$(id)).data.status == 'published';
        allow delete: if own(resource.data.uid) || isAdmin();
      }
      // Likes: one per verified account on a published post.
      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if own(uid) && verified() && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t is number
          && get(/databases/$(database)/documents/posts/$(id)).data.status == 'published';
        allow update: if false;
        allow delete: if own(uid) || isAdmin();
      }
    }
    match /comments/{id} {
      allow read: if signedIn();
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['postId','parentId','moduleId','blogId','body','authorId','authorName','createdAt','likedBy'])
        && request.resource.data.get('parentId','') is string && request.resource.data.get('likedBy',[]) == []
        && request.resource.data.authorId == request.auth.uid
        && (staffOf(request.resource.data.moduleId) || blogStaff(request.resource.data.blogId)
          || ((memberOf(request.resource.data.moduleId) || blogMember(request.resource.data.blogId))
            && request.resource.data.authorName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('penName','')
            && (hasRole('lecturer') || request.resource.data.authorName.matches('^([a-z]+-[a-z]+-[0-9]{3}|student_[a-z0-9]+)$'))))   // an instructor on a shared blog comments under a staff pen name
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 4000
        && str('authorName',60) && request.resource.data.createdAt is number
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.status == 'published'
        && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.moduleId == request.resource.data.moduleId
        && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.get('blogId','') == request.resource.data.blogId
        && get(blogPath(request.resource.data.blogId)).data.get('allowComments', true);
      // Likes on a comment: the only change allowed is an account adding or removing itself from likedBy.
      allow update: if verified()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
        && request.resource.data.likedBy is list
        && ((request.resource.data.likedBy.toSet().difference(resource.data.get('likedBy', []).toSet()) == [request.auth.uid].toSet()
             && resource.data.get('likedBy', []).toSet().difference(request.resource.data.likedBy.toSet()).size() == 0)
          || (resource.data.get('likedBy', []).toSet().difference(request.resource.data.likedBy.toSet()) == [request.auth.uid].toSet()
             && request.resource.data.likedBy.toSet().difference(resource.data.get('likedBy', []).toSet()).size() == 0));
      allow delete: if own(resource.data.authorId) || staffOf(resource.data.moduleId) || blogStaff(resource.data.get('blogId',''));
    }
    match /settings/site { allow read: if true; allow write: if isAdmin(); }
    match /writingSessions/{id} {
      allow read: if staffOf(resource.data.moduleId);
      function sessionShape(){let d=request.resource.data;return verified()
        && d.keys().hasOnly(['uid','postId','moduleId','seconds','startedAt'])
        && d.uid == request.auth.uid && d.postId is string && d.postId.size() <= 100
        && d.moduleId is string && memberOf(d.moduleId)
        && d.startedAt is number && d.startedAt <= request.time.toMillis()+60000
        && d.seconds is int && d.seconds >= 0 && d.seconds * 1000 <= request.time.toMillis() - d.startedAt + 2000
        && (!exists(/databases/$(database)/documents/posts/$(d.postId))
          || (get(/databases/$(database)/documents/posts/$(d.postId)).data.authorId == request.auth.uid
            && get(/databases/$(database)/documents/posts/$(d.postId)).data.moduleId == d.moduleId));}
      allow create: if sessionShape() && request.resource.data.startedAt >= request.time.toMillis()-86400000;
      allow update: if sessionShape() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seconds'])
        && request.resource.data.seconds >= resource.data.seconds;
      allow delete: if false;
    }
    match /writingHistory/{id} {
      allow read: if staffOf(resource.data.moduleId);
      function historyShape(){let d=request.resource.data;return verified()
        && d.keys().hasOnly(['uid','postId','moduleId','seconds','startedAt','lastActivityAt','lastRecordedAt','endedAt','endReason'])
        && d.uid == request.auth.uid && d.postId is string && d.postId.size() <= 100 && memberOf(d.moduleId)
        && d.startedAt is number && d.startedAt <= request.time.toMillis()+60000
        && d.lastActivityAt is number && d.lastActivityAt >= d.startedAt
        && d.lastRecordedAt is number && d.lastRecordedAt >= d.lastActivityAt && d.lastRecordedAt <= request.time.toMillis()+60000
        && d.seconds is int && d.seconds >= 0 && d.seconds * 1000 <= d.lastRecordedAt - d.startedAt + 2000
        && d.get('endedAt',d.lastRecordedAt) == d.lastRecordedAt
        && d.get('endReason','checkpoint') in ['checkpoint','inactive','away','preview','left','interrupted']
        && (!exists(/databases/$(database)/documents/posts/$(d.postId))
          || (get(/databases/$(database)/documents/posts/$(d.postId)).data.authorId == request.auth.uid
            && get(/databases/$(database)/documents/posts/$(d.postId)).data.moduleId == d.moduleId));}
      allow create: if historyShape() && request.resource.data.startedAt >= request.time.toMillis()-86400000;
      allow update: if historyShape() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seconds','lastActivityAt','lastRecordedAt','endedAt','endReason'])
        && request.resource.data.seconds >= resource.data.seconds
        && request.resource.data.lastActivityAt >= resource.data.lastActivityAt
        && request.resource.data.lastRecordedAt >= resource.data.lastRecordedAt
        && (!('endedAt' in resource.data) || request.resource.data == resource.data);
      allow delete: if false;
    }
    match /adminContent/{id} { allow read, write: if isAdmin(); }
    // AI grading assistant: one private review per post, written and read by the admin only.
    // API keys are never stored here; the grader persona lives in adminContent/grader.
    match /aiReviews/{postId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['postId','moduleId','blogId','authorId','provider','model','effort','grade','summary','feedback','raw','error','usage','reviewedAt','inputChars','finalGrade','finalFeedback','finalEditedAt','updatedAt'])
        && request.resource.data.postId == postId && exists(/databases/$(database)/documents/posts/$(postId))
        && str('moduleId',100) && str('blogId',100) && str('authorId',100) && str('provider',40) && str('model',120) && str('effort',20)
        && str('summary',4000) && str('feedback',20000) && str('raw',40000) && str('error',2000) && str('finalGrade',20) && str('finalFeedback',20000)
        && (request.resource.data.get('grade',0) == null || request.resource.data.get('grade',0) is number);
    }
    // Feedback button. ANYONE — signed in or not — may create one bounded submission
    // (as on stouras.com/lit/feedback); only the admin reads, closes or deletes it.
    // A signed-in submitter may record their own uid, nobody else's. Screenshots
    // and voice notes sit in an attachments subcollection, one data URL per
    // document, so no document approaches the 1 MB limit; each must be written
    // in the same batch as (or after) its parent.
    match /feedback/{id} {
      function feedbackShape() { let d = request.resource.data; return d.keys().hasOnly(['text','name','email','uid','role','ticket','url','route','ua','viewport','imageCount','audioCount','status','createdAt'])
        && str('text', 20000) && str('name', 200) && str('email', 320) && str('role', 20) && str('ticket', 64) && str('url', 2000) && str('route', 300) && str('ua', 1000) && str('viewport', 40)
        && (d.get('uid', null) == null || (signedIn() && d.uid == request.auth.uid))
        && d.imageCount is int && d.imageCount >= 0 && d.imageCount <= 5
        && d.audioCount is int && d.audioCount >= 0 && d.audioCount <= 1
        && d.status == 'new' && d.createdAt is number
        && (d.get('text', '').size() > 0 || d.imageCount + d.audioCount > 0); }
      allow create: if feedbackShape();
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolution','closedAt'])
        && request.resource.data.status in ['new','reopened','closed'] && str('resolution', 4000);
      match /attachments/{n} {
        function attachmentShape() { let d = request.resource.data; return d.keys().hasOnly(['kind','mime','dataUrl','bytes','seconds','order'])
          && d.kind in ['image','audio'] && str('mime', 100)
          && d.dataUrl is string && d.dataUrl.size() <= 921600 && d.dataUrl.matches('^data:' + d.kind + '/.*')
          && d.bytes is int && d.seconds is int && d.seconds >= 0 && d.seconds <= 180 && d.order is int && d.order >= 0 && d.order < 6
          && n == string(d.order)
          && existsAfter(/databases/$(database)/documents/feedback/$(id))
          && d.order < getAfter(/databases/$(database)/documents/feedback/$(id)).data.imageCount + getAfter(/databases/$(database)/documents/feedback/$(id)).data.audioCount; }
        allow create: if attachmentShape();
        allow read, delete: if isAdmin();
        allow update: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
